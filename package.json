{
  "name": "my-device-agent",
  "version": "1.0.1",
  "description": "Automated Android Remote Streaming & Device Management Desktop Agent",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@devicefarmer/adbkit": "^3.2.6",
    "@supabase/supabase-js": "^2.48.1",
    "auto-launch": "^5.0.6",
    "axios": "^1.7.9",
    "jpeg-js": "^0.4.4",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.devicefarm.agent",
    "productName": "DeviceFarm Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config.json",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/bin/",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "DeviceFarm Agent"
    }
  }
}
